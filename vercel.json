{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "regions": ["cle1"],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.py?__path__=uploads/$1"
    },
    {
      "source": "/((?!api/|uploads/|assets/|favicon\\.svg|retailsphere_logo\\.jpg|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
